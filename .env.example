# ---- Server ----
PORT=8787
# Public origin of the web app (used for CORS in production)
WEB_ORIGIN=http://localhost:5173
# Random string used to sign the anonymous-session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me-to-a-long-random-string

# SQLite file (relative to apps/server). Use :memory: for throwaway runs.
DATABASE_PATH=./artei.db

# ---- Music catalog ----
# Free developer key from https://devportal.jamendo.com (non-commercial use)
JAMENDO_CLIENT_ID=

# Set to 1 to use a built-in offline catalog with synthesized audio
# (no Jamendo key or network needed — handy for development and tests).
MOCK_CATALOG=0

# ---- Claude (used from phase c) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
